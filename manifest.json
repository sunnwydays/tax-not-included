{
  "manifest_version": 3,
  "name": "Tax Not Included",
  "version": "1.0",
  "description": "Include tax in prices because it should be part of the product price.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/utils.js", "scripts/reprice.js"],
      "matches": ["<all_urls>"],
      "type": "module"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage"
  ]
}